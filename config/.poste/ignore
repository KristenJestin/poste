# Paths (relative to ~) that `poste sys add` refuses to add.
# Taken from the useful rules of the old .chezmoiignore. `*` and `?` do not cross a `/`,
# `**` covers zero folders or more; a pattern that matches a folder covers its content.

# Secrets: never version
.ssh/**
.gnupg/**
.npmrc
.netrc
.docker/.token_seed
.claude/.credentials.json
**/.env
**/.env.*
.config/configstore/**

# Caches and regenerable files
.cache/**
.npm/**
.dotnet/**
.nuget/**
**/__pycache__/**
**/*.bak.*
**/*.bak

# Managed or regenerated by Omarchy and third-party tools
.config/omarchy/current
.claude/skills/omarchy
.claude/plugins
