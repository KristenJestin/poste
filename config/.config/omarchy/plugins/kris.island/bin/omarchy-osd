#!/bin/bash
# Used only by the volume key bindings (~/.config/hypr/bindings.lua put this
# directory first on PATH for omarchy-audio-output-volume). While kris.island is
# the active bar it shows the volume itself, so the volume OSD is skipped;
# everything else goes to Omarchy's real OSD.
real="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-osd"
config="$HOME/.config/omarchy/shell.json"
if [[ " $* " == *" -i volume-"* ]] && [[ $(jq -r '.bar.id // ""' "$config" 2>/dev/null) == "kris.island" ]]; then
  exit 0
fi
exec "$real" "$@"
