#!/usr/bin/env bash
# Wi-Fi backend of the island's Wi-Fi view (NetworkManager via nmcli).
#
#   poste-wifi state [rescan]    JSON: radio, device, ip, ethernet, networks[]
#   poste-wifi up <uuid>         activate a saved connection
#   poste-wifi down <uuid>       deactivate it
#   poste-wifi forget <uuid>     delete it
#   poste-wifi connect <ssid> [security]
#                               new network; the password (if any) is read
#                               from stdin: never in argv, never logged.
#   poste-wifi radio on|off
set -uo pipefail

# Splits nmcli terse output on unescaped ":" and unescapes "\:" / "\\".
terse_to_tsv() {
  sed -e 's/\\\\/\x01/g' -e 's/\\:/\x02/g' -e 's/:/\t/g' -e 's/\x02/:/g' -e 's/\x01/\\/g'
}

state() {
  local rescan=${1:-no}
  local radio device ip eth
  radio=$(nmcli -t radio wifi 2>/dev/null)
  device=$(nmcli -t -f DEVICE,TYPE,STATE device | terse_to_tsv | awk -F'\t' '$2=="wifi"{print $1; exit}')
  ip=""
  [[ -n $device ]] && ip=$(nmcli -g IP4.ADDRESS device show "$device" 2>/dev/null | head -n1 | cut -d/ -f1)
  eth=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device | terse_to_tsv \
    | awk -F'\t' '$2=="ethernet" && $3=="connected"{print $1"\t"$4; exit}')

  # Saved Wi-Fi profiles: uuid <tab> ssid <tab> name
  local known
  known=$(nmcli -t -f UUID,TYPE,NAME connection show | terse_to_tsv \
    | awk -F'\t' '$2=="802-11-wireless"{print $1"\t"$3}' \
    | while IFS=$'\t' read -r uuid name; do
        printf '%s\t%s\t%s\n' "$uuid" "$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)" "$name"
      done)

  local list=""
  if [[ $radio == enabled ]]; then
    list=$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,CHAN device wifi list --rescan "$([[ $rescan == rescan ]] && echo auto || echo no)" 2>/dev/null | terse_to_tsv)
  fi

  jq -n \
    --arg radio "$radio" --arg device "$device" --arg ip "$ip" --arg eth "$eth" \
    --arg known "$known" --arg list "$list" '
    def rows(s): s | split("\n") | map(select(length > 0) | split("\t"));
    (rows($known) | map({uuid: .[0], ssid: .[1], name: .[2]})) as $k
    | {
        radio: ($radio == "enabled"),
        device: $device,
        ip: $ip,
        ethernet: (if $eth == "" then null else ($eth | split("\t") | {device: .[0], name: .[1]}) end),
        networks: (
          rows($list)
          | map({inUse: (.[0] == "*"), ssid: .[1], signal: (.[2] | tonumber? // 0),
                 security: (.[3] // ""), chan: (.[4] // "")})
          | map(select(.ssid != ""))
          | group_by(.ssid)
          | map(sort_by([(if .inUse then 0 else 1 end), -.signal]) | .[0])
          | map(. as $n | ($k | map(select(.ssid == $n.ssid)) | .[0]) as $m
                | $n + {known: ($m != null), uuid: ($m.uuid // "")})
          | sort_by([(if .inUse then 0 elif .known then 1 else 2 end), -.signal])
        )
      }'
}

case ${1:-} in
  state) state "${2:-no}" ;;
  up) nmcli connection up uuid "$2" 2>&1 | tail -n1 ;;
  down) nmcli connection down uuid "$2" 2>&1 | tail -n1 ;;
  forget) nmcli connection delete uuid "$2" 2>&1 | tail -n1 ;;
  connect)
    # Same pattern as Omarchy's own panel: the profile is created without a
    # secret, the passphrase goes through `nmcli connection edit` on stdin,
    # and a failed attempt leaves no half-made profile behind.
    ssid=$2 security=${3:-}
    IFS= read -r password || true
    if [[ -z $password ]]; then
      nmcli device wifi connect "$ssid" 2>&1 | tail -n1
      exit "${PIPESTATUS[0]}"
    fi
    keymgmt=wpa-psk
    [[ $security == *WPA3* && $security != *WPA2* ]] && keymgmt=sae
    uuid=$(uuidgen)
    if nmcli connection add type wifi con-name "$ssid" ssid "$ssid" connection.uuid "$uuid" \
         wifi-sec.key-mgmt "$keymgmt" >/dev/null 2>&1 \
      && printf 'set wifi-sec.psk %s\nsave\nquit\n' "$password" | nmcli connection edit uuid "$uuid" >/dev/null 2>&1 \
      && out=$(nmcli connection up uuid "$uuid" 2>&1); then
      unset password
      printf '%s\n' "$out" | tail -n1
    else
      unset password
      nmcli connection delete uuid "$uuid" >/dev/null 2>&1
      printf '%s\n' "${out:-Connection failed}" | tail -n1
      exit 1
    fi
    ;;
  radio) nmcli radio wifi "$2" ;;
  *) echo "usage: poste-wifi state|up|down|forget|connect|radio" >&2; exit 2 ;;
esac
