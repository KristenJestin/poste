#!/bin/bash
# Ids of the .desktop entries whose program no longer exists (TryExec or Exec
# not found): the island's launcher hides them. E.g. uninstalled Alacritty,
# of which Omarchy left a copy in ~/.local/share/applications.
IFS=: read -ra dirs <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
found() {
  local cmd=$1
  cmd=${cmd#\"}; cmd=${cmd%\"}
  [[ -z $cmd || $cmd == env || $cmd == flatpak ]] && return 0
  if [[ $cmd == /* ]]; then [[ -x $cmd ]]; else command -v "$cmd" >/dev/null 2>&1; fi
}
for d in "${dirs[@]}"; do
  for f in "$d"/applications/*.desktop; do
    [[ -f $f ]] || continue
    try=$(grep -m1 '^TryExec=' "$f" | cut -d= -f2-)
    exe=$(grep -m1 '^Exec=' "$f" | cut -d= -f2- | awk '{print $1}')
    if { [[ -n $try ]] && ! found "$try"; } || { [[ -n $exe ]] && ! found "$exe"; }; then
      basename "$f" .desktop
    fi
  done
done | sort -u
