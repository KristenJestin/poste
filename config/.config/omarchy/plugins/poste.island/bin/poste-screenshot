#!/bin/bash
# Omarchy screenshot + 'snap' sound (poste-sfx) if a file was actually
# created (no sound when the selection is cancelled).
dir="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
mark=$(mktemp)
omarchy-capture-screenshot "$@"
if [[ -n $(find "$dir" -maxdepth 1 -type f -newer "$mark" -print -quit 2>/dev/null) ]]; then
  "$(dirname "$(readlink -f "$0")")/poste-sfx" screenshot
fi
rm -f "$mark"
