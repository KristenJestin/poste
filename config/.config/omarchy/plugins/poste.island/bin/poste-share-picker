#!/usr/bin/env python3
"""Sélecteur de partage d'écran pour xdg-desktop-portal-hyprland
(screencopy:custom_picker_binary dans ~/.config/hypr/xdph.conf).

Si bin/poste-record vient de demander une fenêtre (fichier pick.json de moins
de 20 s dans $XDG_RUNTIME_DIR/poste-record), répond directement avec cette
fenêtre, sans rien afficher. Sinon (partage d'écran d'un navigateur, d'OBS…),
passe la main au sélecteur habituel, hyprland-preview-share-picker.

Protocole xdph : la liste des fenêtres arrive dans XDPH_WINDOW_SHARING_LIST,
« handle[HC>]classe[HT>]titre[HE>]adresse[HA>] » à la suite ; la réponse est
« [SELECTION]r/window:<handle> » sur la sortie standard."""
import json, os, sys, time

PICK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "poste-record", "pick.json")
FALLBACK = "hyprland-preview-share-picker"


def fallback():
    os.execvp(FALLBACK, [FALLBACK] + sys.argv[1:])


try:
    with open(PICK) as f:
        pick = json.load(f)
    os.remove(PICK)
except (OSError, ValueError):
    fallback()

if time.time() - float(pick.get("at", 0)) > 20:
    fallback()


def as_int(value):
    try:
        return int(str(value), 0)
    except ValueError:
        try:
            return int(str(value), 16)
        except ValueError:
            return None


want = as_int(pick.get("address"))
# Trace du dernier choix (titres de fenêtres seulement), pour le dépannage.
try:
    with open(os.path.join(os.path.dirname(PICK), "picker.log"), "w") as log:
        log.write("want=%s\n%s\n" % (pick.get("address"), os.environ.get("XDPH_WINDOW_SHARING_LIST", "")))
except OSError:
    pass
for entry in os.environ.get("XDPH_WINDOW_SHARING_LIST", "").split("[HA>]"):
    if "[HE>]" not in entry:
        continue
    handle = entry.split("[HC>]", 1)[0]
    addr = entry.rsplit("[HE>]", 1)[1]
    if want is not None and as_int(addr) == want:
        print("[SELECTION]r/window:" + handle, flush=True)
        sys.exit(0)

fallback()
