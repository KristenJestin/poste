#!/usr/bin/env python3
"""AI bridge of the island: runs a provider's CLI (Claude, Codex…) and
translates its output into a common format, one JSON line per event:

  {"t": "session", "id": "...", "provider": "claude", "name": "Claude"}
  {"t": "delta", "text": "..."}        text of the answer, as it comes
  {"t": "tool", "name": "WebSearch"}    tool in progress (search, reading…)
  {"t": "done", "text": "...", "error": false}

  poste-ask [--provider P] [--session ID] QUESTION

Providers are declared in ~/.config/poste-island/launcher/launcher.json, key
"ai": { "default": "claude", "providers": { "<id>": { name, format,
command: [...], resume: [...] } } }. In command / resume, "{prompt}" and
"{session}" are replaced. 'format' says how to read the output: claude
(stream-json) or codex (exec --json). Changing provider = changing
"default". Run from ~/.config/poste-island/ai, whose AGENTS.md (memo of the
desktop commands) is read only by this AI; nothing is written here."""
import json, os, subprocess, sys

CONFIG = os.path.expanduser("~/.config/poste-island/launcher/launcher.json")
WORKDIR = os.path.expanduser("~/.config/poste-island/ai")
SYSTEM = ("You answer inside a small launcher panel on the user's Linux desktop (Omarchy, Hyprland). "
          "Be brief and direct, use simple Markdown (short lists, `code`), no preamble. "
          "Answer in the user's language (French by default). "
          "You can run commands and edit files. To start a GUI app or anything long-running, launch it "
          "detached so it survives you and does not block: `setsid -f uwsm-app -- <app> [args] >/dev/null 2>&1` "
          "(or `setsid -f <cmd> >/dev/null 2>&1`); for a terminal program use "
          "`setsid -f xdg-terminal-exec --dir=<dir> <cmd>`. Never use sudo; ask the user instead. "
          "Do not delete, overwrite or push anything unless the user clearly asked for it.")
# Claude's tools and permissions (adjustable in launcher.json, key "ai"):
#   permissionMode : "auto" by default (Claude Code's classifier decides,
#                    like the terminal's auto mode; what it would like to
#                    ask is refused, nothing can be confirmed here)
#   allow          : tools / commands accepted outright
#   deny           : refused outright, whatever the mode
TOOLS = "Read,Glob,Grep,WebSearch,WebFetch,Bash,Edit,Write"
ALLOW = ["Read", "Glob", "Grep", "WebSearch", "WebFetch"]
DENIED = ["Bash(sudo *)", "Bash(rm -r*)", "Bash(rm -fr*)", "Bash(git push*)", "Bash(dd *)", "Bash(mkfs*)",
          "Bash(shutdown*)", "Bash(reboot*)", "Bash(poweroff*)", "Bash(systemctl poweroff*)", "Bash(systemctl reboot*)"]

DEFAULT_PROVIDERS = {
    "claude": {
        "name": "Claude",
        "format": "claude",
        "command": ["claude", "-p", "{prompt}", "--model", "sonnet", "--effort", "medium",
                    "--output-format", "stream-json", "--include-partial-messages", "--verbose",
                    "--tools", TOOLS, "{permissions}",
                    "--append-system-prompt", SYSTEM],
        "resume": ["--resume", "{session}"],
    },
    "codex": {
        "name": "Codex",
        "format": "codex",
        "command": ["codex", "exec", "--json", "--skip-git-repo-check", "-s", "workspace-write",
                    "-c", "model_reasoning_effort=\"medium\"", "{prompt}"],
        "resume_command": ["codex", "exec", "--json", "--skip-git-repo-check", "-s", "workspace-write",
                           "-c", "model_reasoning_effort=\"medium\"", "resume", "{session}", "{prompt}"],
    },
}


def emit(**event):
    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def load_config():
    try:
        with open(CONFIG) as f:
            ai = json.load(f).get("ai") or {}
    except (OSError, ValueError):
        ai = {}
    providers = dict(DEFAULT_PROVIDERS)
    providers.update(ai.get("providers") or {})
    perms = ["--permission-mode", str(ai.get("permissionMode", "auto"))]
    allow = ai.get("allow", ALLOW)
    deny = ai.get("deny", DENIED)
    if allow:
        perms += ["--allowedTools", *allow]
    if deny:
        perms += ["--disallowedTools", *deny]
    return ai.get("default", "claude"), providers, perms


def build(spec, prompt, session, perms):
    def fill(args):
        out = []
        for a in args:
            if a == "{permissions}":
                out += perms
            else:
                out.append(a.replace("{prompt}", prompt).replace("{session}", session or ""))
        return out
    if session and spec.get("resume_command"):
        return fill(spec["resume_command"])
    args = fill(spec["command"])
    if session and spec.get("resume"):
        args += fill(spec["resume"])
    return args


def read_claude(proc, provider, name):
    full, tool = [], None
    for line in proc.stdout:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        t = d.get("type")
        if t == "system" and d.get("subtype") == "init":
            emit(t="session", id=d.get("session_id", ""), provider=provider, name=name)
        elif t == "stream_event":
            ev = d.get("event") or {}
            if ev.get("type") == "content_block_start" and (ev.get("content_block") or {}).get("type") in ("tool_use", "server_tool_use"):
                emit(t="tool", name=ev["content_block"].get("name", "tool"))
            elif ev.get("type") == "content_block_delta" and (ev.get("delta") or {}).get("type") == "text_delta":
                text = ev["delta"].get("text", "")
                full.append(text)
                emit(t="delta", text=text)
        elif t == "result":
            result = d.get("result") or "".join(full)
            emit(t="done", text=result, error=bool(d.get("is_error")))
            return True
    return False


def read_codex(proc, provider, name):
    last = ""
    for line in proc.stdout:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        t = d.get("type", "")
        item = d.get("item") or {}
        if t == "thread.started":
            emit(t="session", id=d.get("thread_id", ""), provider=provider, name=name)
        elif t == "item.started" and item.get("type") in ("command_execution", "web_search", "file_change", "mcp_tool_call"):
            emit(t="tool", name=item.get("type"))
        elif t == "item.completed" and item.get("type") == "agent_message":
            text = item.get("text", "")
            emit(t="delta", text=("\n\n" if last else "") + text)
            last += text
        elif t in ("turn.completed",):
            emit(t="done", text=last, error=False)
            return True
        elif t in ("turn.failed", "error"):
            emit(t="done", text=str((d.get("error") or {}).get("message") or d.get("message") or "error"), error=True)
            return True
    return False


def main():
    args = sys.argv[1:]
    default, providers, perms = load_config()
    provider, session = default, ""
    while args and args[0].startswith("--"):
        flag = args.pop(0)
        if flag == "--provider" and args:
            provider = args.pop(0)
        elif flag == "--session" and args:
            session = args.pop(0)
    prompt = " ".join(args).strip()
    spec = providers.get(provider)
    if not prompt or not spec:
        emit(t="done", text="Unknown provider: " + provider if not spec else "Empty question", error=True)
        return
    name = spec.get("name", provider)
    try:
        proc = subprocess.Popen(build(spec, prompt, session, perms), cwd=WORKDIR if os.path.isdir(WORKDIR) else os.path.expanduser("~"),
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except OSError as e:
        emit(t="done", text=f"{name} could not start: {e.strerror}", error=True)
        return
    reader = read_codex if spec.get("format") == "codex" else read_claude
    finished = reader(proc, provider, name)
    proc.wait()
    if not finished:
        err = (proc.stderr.read() or "").strip().splitlines()
        emit(t="done", text=(err[-1] if err else f"{name} exited with code {proc.returncode}"), error=True)


if __name__ == "__main__":
    main()
