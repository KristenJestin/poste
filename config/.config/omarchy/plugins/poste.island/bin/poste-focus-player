#!/usr/bin/env python3
"""Brings to the front the window the sound comes from (island's player).

  poste-focus-player APP TITLE [URL]

APP: desktopEntry or identity of the MPRIS player ('zen', 'spotify'…).
Among the windows of that app, the one whose title contains TITLE is
preferred (a browser puts the playing tab in its title), then the one whose
title contains the site name of URL ('YouTube'), otherwise the most
recently used. Hyprland 0.56: dispatch in Lua, address checked.
Exit code 3: the app has no window (minimized to the task bar);
the island's player then makes it reappear (MPRIS Raise, or by
relaunching the app)."""
import json, re, subprocess, sys


def norm(s):
    return re.sub(r"[^a-z0-9]", "", str(s).lower())


def main():
    if len(sys.argv) not in (3, 4):
        sys.exit("usage: poste-focus-player APP TITLE [URL]")
    app, title = norm(sys.argv[1]), sys.argv[2].strip().lower()
    host = re.sub(r"^https?://([^/:]+).*$", r"\1", sys.argv[3].lower()) if len(sys.argv) == 4 else ""
    labels = [l for l in host.split(".") if l not in ("www", "m", "music", "open")]
    site = labels[-2] if len(labels) >= 2 else ""
    if not app:
        return
    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")
    mine = [c for c in clients if c.get("mapped") and app and
            (app in norm(c.get("class")) or norm(c.get("class")) in app or app in norm(c.get("initialClass")))
            and norm(c.get("class"))]
    if not mine:
        sys.exit(3)   # no window (app minimized to the task bar)
    def rank(c):
        t = str(c.get("title", "")).lower()
        return (0 if title and title in t else 1 if site and site in t else 2, c.get("focusHistoryID", 999))
    mine.sort(key=rank)
    address = str(mine[0].get("address", ""))
    if re.fullmatch(r"0x[0-9a-f]{1,16}", address):
        subprocess.run(["hyprctl", "dispatch", 'hl.dsp.focus({ window = "address:%s" })' % address],
                       stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
