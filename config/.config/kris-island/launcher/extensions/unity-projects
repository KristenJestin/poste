#!/usr/bin/env python3
"""kris-island launcher source: Unity projects.

Prints a JSON list of launcher items: the projects registered in Unity Hub
(~/.config/unityhub/projects-v1.json) plus any Unity project found in
~/Unity and ~/Projects (ProjectSettings/ProjectVersion.txt), newest first.
Enter opens the project with `unity open` (the Unity CLI picks the right
Editor version and returns right away).
"""
import json, os, glob, shlex

home = os.path.expanduser("~")
projects = {}

def version_of(path):
    try:
        with open(os.path.join(path, "ProjectSettings", "ProjectVersion.txt")) as f:
            for line in f:
                if line.startswith("m_EditorVersion:"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return ""

try:
    with open(os.path.join(home, ".config/unityhub/projects-v1.json")) as f:
        data = json.load(f)
    for p in (data.get("data") or data).values():
        path = p.get("path")
        if path and os.path.isdir(path):
            projects[path] = {"title": p.get("title") or os.path.basename(path),
                              "version": p.get("version") or version_of(path),
                              "modified": p.get("lastModified") or 0,
                              "favorite": bool(p.get("isFavorite"))}
except (OSError, ValueError, AttributeError):
    pass

for root in ("Unity", "Projects"):
    for pv in glob.glob(os.path.join(home, root, "*", "ProjectSettings", "ProjectVersion.txt")):
        path = os.path.dirname(os.path.dirname(pv))
        if path not in projects:
            projects[path] = {"title": os.path.basename(path), "version": version_of(path),
                              "modified": int(os.path.getmtime(pv) * 1000), "favorite": False}

items = []
for path, p in sorted(projects.items(), key=lambda kv: (not kv[1]["favorite"], -kv[1]["modified"])):
    short = path.replace(home, "~", 1)
    items.append({
        "id": path,
        "name": "Open " + p["title"],
        "subtitle": " · ".join(x for x in (p["version"], short) if x),
        "icon": "unityhub",
        "keywords": [p["version"], short],
        "path": path,
        "action": {"type": "command", "command": "unity open " + shlex.quote(path)},
        "actions": [
            {"label": "Open folder", "icon": "󰉋", "action": {"type": "command", "command": "xdg-open " + shlex.quote(path)}},
            {"label": "Open terminal here", "icon": "", "action": {"type": "terminal", "command": "bash", "cwd": path}},
            {"label": "Copy path", "icon": "󰆏", "action": {"type": "copy", "text": path}}
        ]
    })
print(json.dumps(items))
