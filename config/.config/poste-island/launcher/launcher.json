  "ai": {
    "//": "Question rapide à l'IA (« ai » + espace). default = fournisseur ; providers = réglages en plus de ceux de bin/poste-ask (claude, codex) ; Tab change de fournisseur. Claude : permissionMode (auto = le classifieur décide, comme le mode auto du terminal), allow = acceptés d'office, deny = refusés d'office. Ex. allow \"Bash(git status*)\", deny \"Bash(curl *)\".",
    "default": "claude",
    "providers": {},
    "permissionMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(git push*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(poweroff*)",
      "Bash(systemctl poweroff*)",
      "Bash(systemctl reboot*)"
    ]
  }
