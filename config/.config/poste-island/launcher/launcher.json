{
  "//": "poste.island launcher, hot-reloaded. Action types: url, command, terminal, app, copy. Set \"enabled\": false to disable an entry.",
  "items": [
    {
      "enabled": false,
      "name": "GitHub",
      "subtitle": "Open github.com",
      "icon": "🐙",
      "keywords": [
        "git",
        "repo"
      ],
      "type": "url",
      "url": "https://github.com"
    },
    {
      "enabled": false,
      "name": "System monitor",
      "subtitle": "btop in a terminal",
      "icon": "utilities-system-monitor",
      "keywords": [
        "top",
        "cpu",
        "ram",
        "system",
        "monitor"
      ],
      "type": "terminal",
      "command": "btop",
      "cwd": "~"
    },
    {
      "name": "Proton VPN",
      "subtitle": "Open the VPN panel",
      "icon": "network-vpn",
      "keywords": [
        "vpn",
        "proton",
        "protonvpn",
        "connection"
      ],
      "type": "command",
      "command": "omarchy-shell shell summon io.github.grichard99.omaproton-vpn '{}'",
      "requires": "plugin:io.github.grichard99.omaproton-vpn"
    }
  ],
  "extensions": [
    {
      "id": "unity",
      "name": "Unity Projects",
      "subtitle": "Open a project in the editor",
      "icon": "unityhub",
      "keywords": [
        "editor",
        "unity",
        "game",
        "project",
        "projects"
      ],
      "ttl": 300,
      "source": {
        "type": "script",
        "command": "~/.config/poste-island/launcher/extensions/unity-projects"
      },
      "keyword": [
        "open",
        "proj"
      ],
      "requires": "unity"
    },
    {
      "id": "ssh",
      "name": "SSH",
      "subtitle": "Connect to a server",
      "icon": "󰣀",
      "keyword": "ssh",
      "keywords": [
        "ssh",
        "server",
        "remote",
        "connection"
      ],
      "ttl": 60,
      "source": {
        "type": "script",
        "command": "~/.config/poste-island/launcher/extensions/ssh-hosts"
      }
    }
  ],
  "engines": [
    {
      "keyword": "yt",
      "name": "YouTube",
      "url": "https://www.youtube.com/results?search_query=%s",
      "icon": "~/.config/poste-island/launcher/icons/youtube.png",
      "keywords": [
        "youtube",
        "video"
      ]
    },
    {
      "keyword": "ytm",
      "name": "YouTube Music",
      "url": "https://music.youtube.com/search?q=%s",
      "icon": "~/.config/poste-island/launcher/icons/ytmusic.png",
      "keywords": [
        "youtube music",
        "music",
        "ytmusic"
      ]
    },
    {
      "keyword": "gh",
      "name": "GitHub",
      "url": "https://github.com/search?q=%s&type=repositories",
      "icon": "~/.config/poste-island/launcher/icons/github.png",
      "keywords": [
        "github",
        "git",
        "repo"
      ]
    },
    {
      "keyword": "aur",
      "name": "AUR",
      "url": "https://aur.archlinux.org/packages?K=%s",
      "icon": "~/.config/poste-island/launcher/icons/aur.svg",
      "keywords": [
        "arch",
        "package"
      ]
    },
    {
      "keyword": "maps",
      "name": "Maps",
      "url": "https://www.google.com/maps/search/%s",
      "icon": "~/.config/poste-island/launcher/icons/maps.png",
      "keywords": [
        "map",
        "address",
        "directions"
      ]
    }
  ],
  "ai": {
    "//": "Quick question to the AI ('ai' + space). default = provider; providers = settings on top of those of bin/poste-ask (claude, codex); Tab switches provider. Claude: permissionMode (auto = the classifier decides, like the terminal's auto mode), allow = accepted outright, deny = refused outright. E.g. allow \"Bash(git status*)\", deny \"Bash(curl *)\".",
    "default": "claude",
    "providers": {},
    "permissionMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(git push*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(poweroff*)",
      "Bash(systemctl poweroff*)",
      "Bash(systemctl reboot*)"
    ]
  }
}
