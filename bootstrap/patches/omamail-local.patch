diff --git a/ui/account/BridgeSettle.qml b/ui/account/BridgeSettle.qml
new file mode 100644
index 0000000..3c94828
--- /dev/null
+++ b/ui/account/BridgeSettle.qml
@@ -0,0 +1,37 @@
+import QtQuick
+import Quickshell.Io
+
+// Local patch (poste), a file of its own (not in Omamail): MailAccount waits for
+// `settled` before connecting.
+Item {
+  id: root
+  // A local IMAP bridge (a process named `bridge`) takes a while to connect the
+  // account after it starts; an IMAP connection too early is refused
+  // ("Connection in progress"). Only an account served on this machine (the
+  // bridge listens on loopback) waits, until the bridge has run for at least
+  // 60 s (bridge not started yet: check again a few times).
+  property bool needed: false
+  property bool waited: false
+  readonly property bool settled: !needed || waited
+  property int bridgeChecks: 0
+  Process {
+    id: bridgeAge
+    running: root.needed
+    command: ["sh", "-c", "ps -o etimes= -C bridge 2>/dev/null | sort -n | head -1"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        var age = parseInt(String(text).trim(), 10)
+        if (isNaN(age)) {
+          // Bridge not started (yet): at login it starts right after the shell,
+          // so check again a few times before giving up.
+          if (root.bridgeChecks++ < 6) recheckTimer.start()
+          else root.waited = true
+        } else if (age >= 60) root.waited = true
+        else { settleTimer.interval = (60 - age) * 1000; settleTimer.start() }
+      }
+    }
+  }
+  Timer { id: recheckTimer; interval: 5000; onTriggered: bridgeAge.running = true }
+  Timer { id: settleTimer; onTriggered: root.waited = true }
+}
diff --git a/ui/account/DateSort.js b/ui/account/DateSort.js
new file mode 100644
index 0000000..85c168f
--- /dev/null
+++ b/ui/account/DateSort.js
@@ -0,0 +1,22 @@
+.pragma library
+// Local patch (poste), a file of its own (not in Omamail): a local IMAP bridge
+// numbers IMAP UIDs without following the date, so the list came out of
+// order. Stable sort, newest first.
+
+function byDate(rows) {
+  function time(row) {
+    var value = row ? row.date : null
+    if (value && typeof value.getTime === "function") return Number(value.getTime()) || 0
+    var numeric = Number(value)
+    if (isFinite(numeric) && numeric > 0) return numeric < 1e12 ? numeric * 1000 : numeric
+    var parsed = Date.parse(String(value || ""))
+    if (isFinite(parsed) && parsed > 0) return parsed
+    return Number(row && row.internalDate) || 0
+  }
+  var keyed = []
+  for (var i = 0; i < rows.length; i++) keyed.push({ at: time(rows[i]), index: i, row: rows[i] })
+  keyed.sort(function(a, b) { return b.at - a.at || a.index - b.index })
+  var out = []
+  for (var j = 0; j < keyed.length; j++) out.push(keyed[j].row)
+  return out
+}
