diff --git i/ui/account/KrisBridgeSettle.qml w/ui/account/KrisBridgeSettle.qml
new file mode 100644
index 0000000..73f27f0
--- /dev/null
+++ w/ui/account/KrisBridgeSettle.qml
@@ -0,0 +1,34 @@
+import QtQuick
+import Quickshell.Io
+
+// Patch local (kris), fichier ajouté (pas dans Omamail) : MailAccount attend
+// `settled` avant de se connecter.
+Item {
+  id: root
+  // Patch local (kris) : Proton Bridge met un moment à connecter le compte
+  // après son démarrage ; une connexion IMAP trop tôt est refusée (« Connection
+  // in progress »). On attend que Bridge tourne depuis au moins 60 s (pas de
+  // Bridge : pas d'attente ; Bridge pas encore lancé : on revérifie).
+  property bool settled: false
+  Process {
+    id: bridgeAge
+    running: true
+    command: ["sh", "-c", "ps -o etimes= -C bridge 2>/dev/null | sort -n | head -1"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        var age = parseInt(String(text).trim(), 10)
+        if (isNaN(age)) {
+          // Bridge pas (encore) lancé : à l'ouverture de session il démarre
+          // juste après le shell, on revérifie quelques fois avant d'abandonner.
+          if (root.bridgeChecks++ < 6) recheckTimer.start()
+          else root.settled = true
+        } else if (age >= 60) root.settled = true
+        else { settleTimer.interval = (60 - age) * 1000; settleTimer.start() }
+      }
+    }
+  }
+  property int bridgeChecks: 0
+  Timer { id: recheckTimer; interval: 5000; onTriggered: bridgeAge.running = true }
+  Timer { id: settleTimer; onTriggered: root.settled = true }
+}
diff --git i/ui/account/KrisSort.js w/ui/account/KrisSort.js
new file mode 100644
index 0000000..2b281b4
--- /dev/null
+++ w/ui/account/KrisSort.js
@@ -0,0 +1,22 @@
+.pragma library
+// Patch local (kris), fichier ajouté (pas dans Omamail) : Proton Bridge
+// numérote les UID IMAP sans suivre la date, la liste arrivait donc dans le
+// désordre. Tri stable, plus récent d'abord.
+
+function byDate(rows) {
+  function time(row) {
+    var value = row ? row.date : null
+    if (value && typeof value.getTime === "function") return Number(value.getTime()) || 0
+    var numeric = Number(value)
+    if (isFinite(numeric) && numeric > 0) return numeric < 1e12 ? numeric * 1000 : numeric
+    var parsed = Date.parse(String(value || ""))
+    if (isFinite(parsed) && parsed > 0) return parsed
+    return Number(row && row.internalDate) || 0
+  }
+  var keyed = []
+  for (var i = 0; i < rows.length; i++) keyed.push({ at: time(rows[i]), index: i, row: rows[i] })
+  keyed.sort(function(a, b) { return b.at - a.at || a.index - b.index })
+  var out = []
+  for (var j = 0; j < keyed.length; j++) out.push(keyed[j].row)
+  return out
+}
