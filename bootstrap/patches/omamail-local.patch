diff --git a/ui/components/SenderAvatar.qml b/ui/components/SenderAvatar.qml
new file mode 100644
index 0000000..a0fb294
--- /dev/null
+++ b/ui/components/SenderAvatar.qml
@@ -0,0 +1,95 @@
+import QtQuick
+import QtQuick.Effects
+import Quickshell.Io
+import qs.Commons
+
+// Local patch (poste), a file of its own (not in Omamail): the badge of a mail in
+// the list. The sender's initial on a colored disc (color drawn from the name),
+// or the sender's logo when there is one. MessageRow only calls it, so that
+// Omamail updates touch as little as possible.
+Rectangle {
+  id: avatar
+  required property var summary
+  property string fontFamily: ""
+  readonly property string who: String(avatar.summary.from ? avatar.summary.from.display || "" : "")
+  readonly property real hue: {
+    var h = 0
+    for (var i = 0; i < who.length; i++) h = (h * 31 + who.charCodeAt(i)) % 360
+    return h / 360
+  }
+  width: Style.space(30)
+  height: width
+  radius: width / 2
+  readonly property bool hasLogo: logo.status === Image.Ready
+  gradient: Gradient {
+    GradientStop { position: 0; color: avatar.hasLogo ? "transparent" : Qt.hsla(avatar.hue, 0.75, 0.62, 1) }
+    GradientStop { position: 1; color: avatar.hasLogo ? "transparent" : Qt.hsla(avatar.hue, 0.7, 0.45, 1) }
+  }
+  // The sender's logo, found by poste-sender-logo (poste.island): BIMI, then the
+  // icons the site declares, in a local cache. Nothing found (or no script): the
+  // initial stays.
+  readonly property string domain: {
+    // Never for spam: their sites are not contacted.
+    if (avatar.summary.inSpam) return ""
+    var email = String(avatar.summary.from ? avatar.summary.from.email || "" : "").toLowerCase()
+    var d = email.split("@")[1] || ""
+    // Reverse alias of a mail alias service (hello_at_example_com_xxxx@<alias
+    // domain>): the sender's real domain is written in the address.
+    var alias = email.split("@")[0].match(/_at_([a-z0-9-]+(?:_[a-z0-9-]+)+)_[a-z0-9]+$/)
+    if (alias) d = alias[1].replace(/_/g, ".")
+    return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(d) ? d : ""
+  }
+  property string logoPath: ""
+  onDomainChanged: { logoPath = ""; if (domain !== "") logoProc.running = true }
+  Component.onCompleted: if (domain !== "") logoProc.running = true
+  Process {
+    id: logoProc
+    command: ["sh", "-c", 'exec "$HOME/.config/omarchy/plugins/poste.island/bin/poste-sender-logo" "$1" "$2" 2>/dev/null', "poste-sender-logo", avatar.domain, avatar.who]
+    stdout: StdioCollector { onStreamFinished: avatar.logoPath = String(this.text).trim() }
+  }
+  // The logo as is, no background, rounded corners (the shape these icons are
+  // drawn for); the colored disc disappears under it.
+  Item {
+    id: logoMask
+    anchors.fill: parent
+    visible: false
+    layer.enabled: true
+    Rectangle { anchors.fill: parent; radius: width * 0.26; color: "black" }
+  }
+  Item {
+    anchors.fill: parent
+    visible: logo.status === Image.Ready
+    z: 1
+    layer.enabled: true
+    layer.effect: MultiEffect {
+      maskEnabled: true
+      maskSource: logoMask
+      maskThresholdMin: 0.5
+      maskSpreadAtMin: 1.0
+    }
+    Image {
+      id: logo
+      anchors.fill: parent
+      sourceSize.width: 96
+      sourceSize.height: 96
+      fillMode: Image.PreserveAspectFit
+      smooth: true
+      asynchronous: true
+      cache: false
+      source: avatar.logoPath !== "" ? "file://" + avatar.logoPath : ""
+    }
+  }
+  TextMetrics { id: avatarMetrics; text: avatarLetter.text; font: avatarLetter.font }
+  Text {
+    id: avatarLetter
+    visible: !avatar.hasLogo
+    // Centered on the drawn letter, not on the text box.
+    anchors.horizontalCenter: parent.horizontalCenter
+    y: parent.height / 2 - baselineOffset - (avatarMetrics.tightBoundingRect.y + avatarMetrics.tightBoundingRect.height / 2)
+    text: (avatar.who.replace(/^[^A-Za-zÀ-ÿ0-9]+/, "").charAt(0) || "?").toUpperCase()
+    color: "white"
+    font.family: avatar.fontFamily
+    font.pixelSize: Style.font.body
+    font.weight: Font.Bold
+  }
+}
