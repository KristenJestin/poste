diff --git i/ui/components/KrisAvatar.qml w/ui/components/KrisAvatar.qml
new file mode 100644
index 0000000..494454f
--- /dev/null
+++ w/ui/components/KrisAvatar.qml
@@ -0,0 +1,97 @@
+import QtQuick
+import QtQuick.Effects
+import Quickshell.Io
+import qs.Commons
+
+// Patch local (kris), fichier ajouté (pas dans Omamail) : la pastille d'un
+// mail dans la liste. Initiale de l'expéditeur sur un rond coloré (couleur
+// tirée de son nom), ou son logo s'il en a un. MessageRow ne fait que
+// l'appeler, pour que les mises à jour d'Omamail touchent le moins possible.
+Rectangle {
+  id: avatar
+  required property var summary
+  property string fontFamily: ""
+  readonly property string who: String(avatar.summary.from ? avatar.summary.from.display || "" : "")
+  readonly property real hue: {
+    var h = 0
+    for (var i = 0; i < who.length; i++) h = (h * 31 + who.charCodeAt(i)) % 360
+    return h / 360
+  }
+  width: Style.space(30)
+  height: width
+  radius: width / 2
+  readonly property bool hasLogo: logo.status === Image.Ready
+  gradient: Gradient {
+    GradientStop { position: 0; color: avatar.hasLogo ? "transparent" : Qt.hsla(avatar.hue, 0.75, 0.62, 1) }
+    GradientStop { position: 1; color: avatar.hasLogo ? "transparent" : Qt.hsla(avatar.hue, 0.7, 0.45, 1) }
+  }
+  // Logo de l'expéditeur, trouvé par poste-sender-logo (île poste.island) :
+  // BIMI, puis icônes déclarées par le site, en cache local. Rien trouvé
+  // (ou script absent) : l'initiale reste.
+  readonly property string domain: {
+    // Jamais pour les spams : on ne contacte pas leurs sites.
+    if (avatar.summary.inSpam) return ""
+    var email = String(avatar.summary.from ? avatar.summary.from.email || "" : "").toLowerCase()
+    var d = email.split("@")[1] || ""
+    // Alias Proton (hello_at_example_com_xxxx@passmail.net) : le vrai domaine
+    // de l'expéditeur est écrit dans l'alias.
+    if (d === "passmail.net" || d === "passinbox.com" || d === "passfwd.com") {
+      var m = email.split("@")[0].match(/_at_([a-z0-9_-]+)_[a-z0-9]+$/)
+      d = m ? m[1].replace(/_/g, ".") : ""
+    }
+    return /^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(d) ? d : ""
+  }
+  property string logoPath: ""
+  onDomainChanged: { logoPath = ""; if (domain !== "") logoProc.running = true }
+  Component.onCompleted: if (domain !== "") logoProc.running = true
+  Process {
+    id: logoProc
+    command: ["sh", "-c", 'exec "$HOME/.config/omarchy/plugins/poste.island/bin/poste-sender-logo" "$1" "$2" 2>/dev/null', "poste-sender-logo", avatar.domain, avatar.who]
+    stdout: StdioCollector { onStreamFinished: avatar.logoPath = String(this.text).trim() }
+  }
+  // Logo tel quel, sans fond, arrondi aux coins (forme prévue pour ces
+  // icônes) ; la pastille colorée disparaît dessous.
+  Item {
+    id: logoMask
+    anchors.fill: parent
+    visible: false
+    layer.enabled: true
+    Rectangle { anchors.fill: parent; radius: width * 0.26; color: "black" }
+  }
+  Item {
+    anchors.fill: parent
+    visible: logo.status === Image.Ready
+    z: 1
+    layer.enabled: true
+    layer.effect: MultiEffect {
+      maskEnabled: true
+      maskSource: logoMask
+      maskThresholdMin: 0.5
+      maskSpreadAtMin: 1.0
+    }
+    Image {
+      id: logo
+      anchors.fill: parent
+      sourceSize.width: 96
+      sourceSize.height: 96
+      fillMode: Image.PreserveAspectFit
+      smooth: true
+      asynchronous: true
+      cache: false
+      source: avatar.logoPath !== "" ? "file://" + avatar.logoPath : ""
+    }
+  }
+  TextMetrics { id: avatarMetrics; text: avatarLetter.text; font: avatarLetter.font }
+  Text {
+    id: avatarLetter
+    visible: !avatar.hasLogo
+    // Centré sur le dessin de la lettre, pas sur la boîte du texte.
+    anchors.horizontalCenter: parent.horizontalCenter
+    y: parent.height / 2 - baselineOffset - (avatarMetrics.tightBoundingRect.y + avatarMetrics.tightBoundingRect.height / 2)
+    text: (avatar.who.replace(/^[^A-Za-zÀ-ÿ0-9]+/, "").charAt(0) || "?").toUpperCase()
+    color: "white"
+    font.family: avatar.fontFamily
+    font.pixelSize: Style.font.body
+    font.weight: Font.Bold
+  }
+}
