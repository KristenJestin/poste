// Unity Hub / CLI encrypt their credentials with systemd-creds: allowed
// without a password for @USER@ in an active local session.
polkit.addRule(function(action, subject) {
  if ((action.id == "io.systemd.credentials.encrypt" ||
       action.id == "io.systemd.credentials.decrypt") &&
      subject.user == "@USER@" && subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
