#!/bin/bash
# poste usage : quotas des agents IA, lus dans les fichiers du collecteur d'Omarchy
# (omarchy-agent-usage-update, ~/.local/state/omarchy/agents/usage/<agent>.json),
# la même source que le centre de contrôle de l'île. Un relevé de plus de 5 minutes
# est refait avant d'afficher (--limits-only : seulement les limites, rapide).
#
# poste usage record : relevé de tous les agents, ajouté à l'historique
# (~/.local/state/poste/usage/history.jsonl) seulement s'il a changé ; lancé toutes les
# 5 minutes par le minuteur poste-usage-record.timer. poste usage history : le relire.

set -euo pipefail

DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
HISTORY="${XDG_STATE_HOME:-$HOME/.local/state}/poste/usage/history.jsonl"
MAX_AGE=300

usage() {
  cat <<'H'
Usage : poste usage [agent] [--all] [--refresh] [--json]
        poste usage history [agent…] [--since <date>] [--json]
        poste usage record
  agent      claude (défaut), codex… : un fichier par agent dans le collecteur d'Omarchy
  --all      tous les agents relevés
  --refresh  refait le relevé avant d'afficher
  --json     l'enregistrement brut du collecteur ; pour history, les lignes de l'historique (JSONL)
  history    l'historique des relevés (24 dernières heures par défaut ; --since accepte ce que
             comprend date -d : « 3 days ago », « 2026-10-01 »…)
  record     relève tous les agents et ajoute à l'historique ce qui a changé (le minuteur)
H
}

# Le collecteur d'Omarchy, s'il est là. Hors session (minuteur), OMARCHY_PATH peut manquer :
# omarchy-agent-usage-update en a besoin pour trouver les collecteurs, on le déduit de son chemin.
update() {
  local bin
  if ! bin=$(command -v omarchy-agent-usage-update); then
    echo "poste usage : omarchy-agent-usage-update introuvable, relevé non actualisé" >&2
    return 0
  fi
  [[ -n ${OMARCHY_PATH:-} ]] || export OMARCHY_PATH="${bin%/bin/*}"
  omarchy-agent-usage-update --limits-only "$@" >/dev/null 2>&1 || true
}

# Un relevé réduit à ce qui compte pour l'historique : heure du passage (UTC), agent, et pour chaque
# limite son libellé, son pourcentage (0-100, une décimale) et sa remise à zéro arrondie à la
# minute (le serveur la renvoie à la microseconde près, et elle bouge d'un relevé à l'autre).
# Rien pour un agent en erreur ou sans limite. Jamais de jeton ni d'identifiant de compte.
# shellcheck disable=SC2016
SNAPSHOT='
  def utc_minute: if test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$")
    then .[0:19] + "Z" | fromdateiso8601 | (. + 30) / 60 | floor * 60 | todate else . end;
  select((.usageStatusText // "") == "" and ((.limits // []) | length) > 0)
  | {t: $now,
     agent: $agent,
     limits: [.limits[] | {label: (.title // .label),
                           percent: ((.percent // 0) * 1000 | round / 10),
                           resetsAt: ((.resetsAt // "") | utc_minute)}]}'

record() {
  command -v jq >/dev/null || { echo "poste usage : jq manquant" >&2; exit 1; }
  update
  mkdir -p "$(dirname "$HISTORY")"
  local now f agent snap last
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  for f in "$DIR"/*.json; do
    [[ -e $f ]] || continue
    agent=$(basename "$f" .json)
    snap=$(jq -c --arg now "$now" --arg agent "$agent" "$SNAPSHOT" "$f" 2>/dev/null) || continue
    [[ -n $snap ]] || continue
    last=""
    [[ -e $HISTORY ]] && last=$(grep -F "\"agent\":\"$agent\"" "$HISTORY" | tail -n 1 | jq -c .limits 2>/dev/null || true)
    [[ $last == "$(jq -c .limits <<<"$snap")" ]] && continue
    printf '%s\n' "$snap" >>"$HISTORY"
  done
}

show_history() {
  command -v jq >/dev/null || { echo "poste usage : jq manquant" >&2; exit 1; }
  local since="24 hours ago" json=0 names=()
  while (($#)); do
    case "$1" in
    --since) since="${2:?--since demande une date}"; shift ;;
    --since=*) since="${1#--since=}" ;;
    --json) json=1 ;;
    -*) echo "poste usage history : option inconnue $1" >&2; usage >&2; exit 2 ;;
    *) names+=("$1") ;;
    esac
    shift
  done
  local from
  from=$(date -u -d "$since" +%Y-%m-%dT%H:%M:%SZ) || { echo "poste usage history : date illisible : $since" >&2; exit 2; }
  [[ -e $HISTORY ]] || { echo "poste usage history : pas encore d'historique ($HISTORY)" >&2; exit 1; }
  local agents
  agents=$(printf '%s\n' "${names[@]}" | jq -R . | jq -sc 'map(select(. != ""))')
  # shellcheck disable=SC2016
  local sel='select(.t >= $from and (($agents | length) == 0 or (.agent as $a | $agents | index($a))))'
  if ((json)); then
    jq -c --arg from "$from" --argjson agents "$agents" "$sel" "$HISTORY"
    return
  fi
  # Une ligne par relevé : heure locale, agent, puis chaque limite et sa remise à zéro.
  jq -r --arg from "$from" --argjson agents "$agents" \
    "$sel"' | [(.t | fromdateiso8601 | strflocaltime("%d/%m %H:%M")), .agent,
      (.limits | map("\(.label) \(.percent) %" + (if .resetsAt != "" then " (\(.resetsAt | fromdateiso8601 | strflocaltime("%d/%m %H:%M")))" else "" end)) | join(", "))]
      | "\(.[0])  \(.[1])  \(.[2])"' "$HISTORY"
}

case "${1:-}" in
record) record; exit 0 ;;
history) shift; show_history "$@"; exit 0 ;;
esac

agents=() all=0 refresh=0 json=0
for a in "$@"; do
  case "$a" in
  -h | --help | help) usage; exit 0 ;;
  --all) all=1 ;;
  --refresh) refresh=1 ;;
  --json) json=1 ;;
  -*) echo "poste usage : option inconnue $a" >&2; usage >&2; exit 2 ;;
  *) agents+=("$a") ;;
  esac
done

command -v jq >/dev/null || { echo "poste usage : jq manquant" >&2; exit 1; }

if ((all)); then
  agents=()
  for f in "$DIR"/*.json; do [[ -e $f ]] && agents+=("$(basename "$f" .json)"); done
elif ((${#agents[@]} == 0)); then
  agents=(claude)
fi

# Relevé : s'il manque, s'il est vieux, ou sur demande.
stale=()
now=$(date +%s)
for a in "${agents[@]}"; do
  f="$DIR/$a.json"
  if ((refresh)) || [[ ! -e $f ]] || ((now - $(stat -c %Y "$f") > MAX_AGE)); then stale+=("$a"); fi
done
((${#stale[@]})) && update "${stale[@]}"

code=0
for a in "${agents[@]}"; do
  f="$DIR/$a.json"
  if [[ ! -e $f ]]; then
    echo "$a : aucun relevé (agent inconnu du collecteur d'Omarchy ?)" >&2
    code=1
    continue
  fi
  if ((json)); then
    jq -c . "$f"
    continue
  fi
  age=$(((now - $(stat -c %Y "$f")) / 60))
  name=$(jq -r '.name // .title // .id' "$f")
  echo "$name (relevé il y a ${age} min)"
  status=$(jq -r '.usageStatusText // ""' "$f")
  if [[ -n $status ]]; then
    echo "  $status"
    hint=$(jq -r '.authHelpText // ""' "$f")
    [[ -n $hint ]] && echo "  $hint"
    code=1
    continue
  fi
  # Une ligne par limite : libellé, pourcentage, remise à zéro à l'heure locale.
  jq -r '.limits[]? | [(.title // .label), ((.percent // 0) * 100 | round | tostring), (.resetsAt // "")] | @tsv' "$f" |
    while IFS=$'\t' read -r label pct reset; do
      when=""
      # +1 s : une remise annoncée à 17:59:59 s'affiche 18:00.
      [[ -n $reset ]] && when=", remise à zéro le $(date -d "@$(($(date -d "$reset" +%s) + 1))" '+%d/%m à %H:%M')"
      printf '  %-20s %3s %%%s\n' "$label" "$pct" "$when"
    done
done
exit $code
