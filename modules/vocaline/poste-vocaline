#!/bin/sh
# Module vocaline de poste : passe la commande telle quelle au programme Vocaline de la machine.
# Son chemin : clé `bin` de ~/.config/poste/vocaline.toml (posé par le dépôt de données de la
# machine), sinon `vocaline` du PATH.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/poste/vocaline.toml"
bin=
if [ -f "$conf" ]; then
  bin=$(sed -n 's/^[[:space:]]*bin[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$conf" | head -n 1)
fi
[ -n "$bin" ] || bin=vocaline
case "$bin" in
  "~/"*) bin="$HOME/${bin#"~/"}" ;;
esac
if ! command -v "$bin" >/dev/null 2>&1; then
  echo "poste vocaline : programme introuvable ($bin) ; le régler par bin dans $conf" >&2
  exit 127
fi
exec "$bin" "$@"
