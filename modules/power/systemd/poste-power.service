[Unit]
Description=poste power: battery and disk alerts
Documentation=file://%h/Projects/poste/modules/power/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/poste/modules/power/poste-power watch
# omarchy-notification-send (Omarchy 4: /usr/share/omarchy/bin) must be findable from the start of the session.
Environment=PATH=%h/.local/share/omarchy/bin:/usr/share/omarchy/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=10
# The daemon sleeps almost all the time: minimal priority and capped memory.
Nice=19
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
