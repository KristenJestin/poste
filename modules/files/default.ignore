# Default exclusions of `poste files`, .gitignore syntax, anchored on each root.
# The machine's exclusions (files/ignore of its data repository, then
# ~/.local/share/poste/files/ignore) are read after this file: the last matching line wins, so
# they can add exclusions or lift them ("!build/").
# The .gitignore files met are not read.

# Hidden files and folders ("!.config/" to keep one)
.*

# Dependencies, caches and build outputs
.git/
.cache/
node_modules/
# Unity
Library/
target/
dist/
build/
node/
.venv/
__pycache__/
.next/
.svelte-kit/
