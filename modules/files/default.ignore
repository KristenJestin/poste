# Default exclusions of `poste files`, .gitignore syntax, anchored on each root.
# ~/.config/poste/files.ignore is read after this file: the last matching line wins, so it can
# add exclusions or lift them ("!build/").
# The .gitignore files met are not read.

# Hidden files and folders ("!.config/" to keep one)
.*

# Dependencies, caches and build outputs
.git/
.cache/
node_modules/
# Unity
Library/
target/
dist/
build/
node/
.venv/
__pycache__/
.next/
.svelte-kit/
