#!/bin/sh
# Screen-share picker of xdg-desktop-portal-hyprland (line `screencopy:custom_picker_binary`
# put by `poste sys setup`). Stable path; the work is done by `poste-record share-picker`
# (Rust), installed next to it in the module folder. If the binary is missing, we hand over to the
# usual picker, as the picker itself would when it has nothing to do.
dir=$(dirname "$0")
if [ -x "$dir/../poste-record" ]; then
  exec "$dir/../poste-record" share-picker "$@"
fi
exec hyprland-preview-share-picker "$@"
