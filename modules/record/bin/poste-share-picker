#!/bin/sh
# Sélecteur de partage d'écran de xdg-desktop-portal-hyprland (ligne `screencopy:custom_picker_binary`
# posée par `poste sys setup`). Chemin stable ; le travail est fait par `poste-record share-picker`
# (Rust), installé à côté dans le dossier du module. Si le binaire manque, on passe la main au
# sélecteur habituel, comme le ferait le sélecteur lui-même quand il n'a rien à faire.
dir=$(dirname "$0")
if [ -x "$dir/../poste-record" ]; then
  exec "$dir/../poste-record" share-picker "$@"
fi
exec hyprland-preview-share-picker "$@"
