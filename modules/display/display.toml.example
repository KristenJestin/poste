# Profils d'écrans de poste display. À copier en ~/.config/poste/display.toml (local à la machine,
# non versionné) puis à ajuster : `cp display.toml.example ~/.config/poste/display.toml`.
#
# Exemple tiré du portable pro (vérifié au bureau le 2026-10-12).
#
# Un profil dit seulement OÙ sont les écrans (mode, position, échelle, rotation) et, au besoin, quelles
# fenêtres ranger. Les espaces de travail de chaque écran ne sont PAS ici : ils viennent de
# ~/.config/hypr/monitors.lua (`workspace_monitors` : le 1er écran a 1-10, le 2e 11-20, le 3e 21-30).
#
# Choisir quel profil s'applique : un profil correspond quand TOUS ses `detect` et AU MOINS UN de ses
# `detect_any` sont présents parmi les écrans EXTERNES branchés ; un profil sans `detect` ni
# `detect_any` ne correspond que lorsqu'aucun écran externe n'est branché. Le plus précis gagne
# (le plus de critères), à égalité le premier du fichier. Aucun profil ne correspond (écran inconnu,
# vidéoprojecteur) : rien n'est changé, Hyprland garde sa règle par défaut.
#
# Un critère (detect, detect_any, match) est soit un morceau de la description EDID de l'écran
# (`poste display status`, sans tenir compte de la casse), soit `connector:NOM` pour le nom de la
# prise (HDMI-A-1, DP-1…). Préférer l'EDID : une prise correspond à n'importe quel écran qu'on y branche.

# Écran interne du portable.
internal = "eDP-1"
# Notification discrète quand le démon change de profil tout seul.
notify = true

# ---------------------------------------------------------------------------------------------
# NOMADE : le portable seul. Les fenêtres restées sur les espaces des écrans du bureau (1-10 pour
# l'écran portrait, 11-20 pour celui du milieu, d'après monitors.lua) sont rangées sur ceux du
# portable (21-30), les seuls que la barre de l'île y montre : 1 et 11 vont sur 21, 2 et 12 sur 22…
[[profile]]
name = "nomade"
label = "Nomade"

[profile.internal]
enabled = true
mode = "2880x1800@120"
position = "0x0"
scale = 1.6

[[profile.rescue]]
from = "1-10"
to = "21-30"

[[profile.rescue]]
from = "11-20"
to = "21-30"

# ---------------------------------------------------------------------------------------------
# BOULOT : le portable sous l'écran du milieu (AOC 24G2W1G3, en HDMI), l'écran portrait (même
# modèle, sur le dock) à gauche. Reconnus par leur numéro de série ; un seul des deux suffit.
[[profile]]
name = "boulot"
label = "Boulot"
detect_any = ["24G2W1G3- SERIE000000002", "24G2W1G3- SERIE000000001"]

[profile.internal]
enabled = true
mode = "2880x1800@120"
position = "0x0"
scale = 1.6

[[profile.monitor]]
match = "24G2W1G3- SERIE000000002"   # milieu, au-dessus du portable
mode = "1920x1080@144"
position = "0x-1080"
scale = 1

[[profile.monitor]]
match = "24G2W1G3- SERIE000000001"   # gauche, en portrait
mode = "1920x1080@144"
position = "-1080x-1080"
scale = 1
transform = 1            # 90 degrés ; si l'image est à l'envers, mettre 3

# Ranger des fenêtres en appliquant un profil (`[[profile.rescue]]`) : `from` est un numéro
# d'espace, une plage (`1-10`) ou un nom d'espace (`mid`) ; `to` un numéro, ou une plage de même
# longueur que `from`.
#
# Pour désactiver le portable quand il est branché à des écrans (attention : la bascule « clamshell »
# d'Omarchy 4, omarchy-hyprland-monitor-clamshell, gère aussi l'écran interne à la fermeture du capot) :
#   [profile.internal]
#   enabled = false
