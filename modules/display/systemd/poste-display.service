[Unit]
Description=poste display : profils d'écrans selon les écrans branchés
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/poste/modules/display/poste-display watch
# hyprctl et omarchy-notification-send (Omarchy 4 : /usr/share/omarchy/bin) doivent être trouvables.
Environment=PATH=%h/.local/share/omarchy/bin:/usr/share/omarchy/bin:%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=5
Nice=10
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
