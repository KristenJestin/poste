#!/usr/bin/env bash
# First run of poste (fresh Omarchy): checks cargo, records the location of the
# repository, builds, then lets `poste-sys setup` install (binaries, config, steps of bootstrap/). Options: --yes, --dry-run, --no-config, --take-repo, --take-home, --data.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

pass=()
data=""
dry=0
while (($#)); do
  arg="$1"
  shift
  case "$arg" in
    -y | --yes) pass+=(--yes) ;;
    -n | --dry-run) pass+=(--dry-run); dry=1 ;;
    --no-config) pass+=(--no-config) ;;
    --take-repo | --take-home)
      if (($# == 0)); then
        echo "setup: $arg expects a path" >&2
        exit 2
      fi
      pass+=("$arg" "$1")
      shift
      ;;
    --data)
      if (($# == 0)); then
        echo "setup: --data expects the git address or the folder of the data repository" >&2
        exit 2
      fi
      data="$1"
      shift
      ;;
    -h | --help)
      echo "Usage: ./setup [--yes] [--dry-run] [--no-config] [--take-repo PATH]... [--take-home PATH]... [--data ADDRESS|FOLDER]"
      exit 0
      ;;
    *)
      echo "setup: unknown option: $arg" >&2
      exit 2
      ;;
  esac
done

if ! command -v cargo > /dev/null 2>&1; then
  echo "setup: cargo not found. Install Rust (poste never runs sudo), then run ./setup again:" >&2
  echo "  sudo pacman -S --needed rust" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/poste/config.toml"
mkdir -p "$(dirname "$config")"

# Writes (or updates) a top-level key without touching the rest of the config.
set_key() {
  local key="$1" value="$2" line tmp
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  line="$key = \"$value\""
  tmp="$(mktemp "$config.XXXXXX")"
  if [[ -f $config ]] && grep -Eq "^[[:space:]]*$key[[:space:]]*=" "$config"; then
    # The key exists: only that line is replaced.
    NEWLINE="$line" KEY="$key" awk '
      !done && $0 ~ "^[[:space:]]*" ENVIRON["KEY"] "[[:space:]]*=" { print ENVIRON["NEWLINE"]; done = 1; next }
      { print }
    ' "$config" > "$tmp"
  else
    # A top-level key must come before any table: it is added at the top.
    { echo "$line"; [[ -f $config ]] && cat "$config"; true; } > "$tmp"
  fi
  if [[ -f $config ]] && cmp -s "$tmp" "$config"; then
    rm -f "$tmp"
  else
    chmod 644 "$tmp"
    mv "$tmp" "$config"
    echo "Config: $key saved in $config"
  fi
}

set_key repo "$repo"

# The machine's data repository (private): an existing folder, or a git address cloned
# next to the repository (poste-data).
if [[ -n $data ]]; then
  if [[ -d $data ]]; then
    data="$(cd "$data" && pwd -P)"
  else
    dest="$(dirname "$repo")/poste-data"
    if [[ -e $dest ]]; then
      echo "setup: $dest already exists; pass this folder to --data, or move it" >&2
      exit 1
    fi
    if ((dry)); then
      echo "Dry run: git clone $data $dest not run, data not saved."
      data=""
    else
      echo "Cloning the data repository into $dest…"
      git clone "$data" "$dest"
      data="$dest"
    fi
  fi
  if [[ -n $data ]]; then set_key data "$data"; fi
fi

echo "Building the workspace (release)…"
cargo build --release --manifest-path "$repo/Cargo.toml"

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) echo "Warning: $HOME/.local/bin is not in your PATH, the 'poste' command will not be found." >&2 ;;
esac

exec "$repo/target/release/poste-sys" setup "${pass[@]}"
